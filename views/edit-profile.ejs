<%- include("partials/header.ejs") %>
    <div class="col-md-10 mx-auto col-lg-5 my-3">
        <h1>Update Profile</h1>
        <div class="signup-form pb-4">
            <form class="p-4 p-md-5 pb-3 pb-md-3 border rounded-3" action="/update-profile" method="post">
                <div class="form-floating mb-3">
                    <input type="text" name="full_name" class="form-control" value=<%=name %> id="full_name"
                    placeholder="Full Name"
                    fdprocessedid="t8e1p6" required>
                    <label for="full_name">Full Name</label>
                </div>

                <div class="form-floating mb-3">
                    <input type="email" name="email" class="form-control" value=<%=email %> id="floatingInput"
                    placeholder="name@example.com" fdprocessedid="nx384" required>
                    <label for="floatingInput">Email</label>
                </div>
                <% if(!locals.isGoogleAccount) { %>
                    <div class="form-floating mb-3">
                        <input type="password" name="oldPassword" class="form-control" id="floatingPassword"
                            placeholder="Password" fdprocessedid="t8e1p6">
                        <label for="floatingPassword">Old Password</label>
                    </div>

                    <div class="form-floating mb-3">
                        <input type="password" name="newPassword" class="form-control" id="floatingPassword"
                            placeholder="Password" fdprocessedid="t8e1p6">
                        <label for="floatingPassword">New Password</label>
                    </div>

                    <div class="form-floating mb-3">
                        <input type="password" name="confirmPassword" class="form-control" id="floatingPassword"
                            placeholder="Password" fdprocessedid="t8e1p6">
                        <label for="floatingPassword">Confirm Password</label>
                    </div>
                    <% } %>
                        <div class="form-floating mb-3">
                            <input type="text" name="img_url" class="form-control" value=<%=image %> id="img_url"
                            placeholder="Image URL(Optional)" fdprocessedid="t8e1p6">
                            <label for="img_url">Image URL</label>
                        </div>
                        <% if (locals.errorMessage) { %>
                            <p class="error-message text-center">
                                <%= errorMessage %>
                            </p>
                            <% } %>
                                <div class="d-flex flex-row justify-content-center">
                                    <button class="btn btn-lg btn-primary signup-btn-form me-2" type="submit"
                                        fdprocessedid="97z82">Update Profile</button>

                                </div>

            </form>
            <div class="container d-flex flex-row justify-content-center">
                <a class="delete-profile-link text-center" href="/delete-profile-confirmation"
                    style="color: #b90e0a; text-decoration: none;">
                    Delete Profile
                </a>
            </div>


        </div>


    </div>
    <%- include("partials/footer.ejs") %>